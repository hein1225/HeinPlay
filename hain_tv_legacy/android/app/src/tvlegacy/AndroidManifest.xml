<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- 部分机顶盒/电视的 GPU 对 Vulkan swapchain 支持不完整，启用 Impeller 会在
             raster 线程触发 SIGSEGV（如 SkyworthDigitalRT-Q601F Android 10）。
             tvLegacy 版禁用 Impeller，回退到 Skia + OpenGL ES，提升低端设备稳定性。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>

</manifest>
